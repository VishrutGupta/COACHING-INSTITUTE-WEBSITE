# ========================================================
# SUPABASE CONFIGURATION
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must NEVER be committed.
# ========================================================

# Your Supabase Project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Public Key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public site URL used for SEO / sitemap / absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default institute slug seeded by supabase/SEED_DATABASE.sql
NEXT_PUBLIC_DEFAULT_INSTITUTE_SLUG=my-coaching-institute

# Server-only: Service Role Key. NEVER expose through NEXT_PUBLIC_*.
# Used only in server route handlers for user management.
SUPABASE_SERVICE_ROLE_KEY=
